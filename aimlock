local function createSlider(labelText, yPos, maxVal, initialVal, callback)
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -16, 0, 14)
    label.Position = UDim2.new(0, 8, 0, yPos)
    label.Text = labelText
    label.TextColor3 = Color3.new(1,1,1)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.SourceSans
    label.TextSize = 12

    local back = Instance.new("Frame", frame)
    back.Size = UDim2.new(1, -16, 0, 8)
    back.Position = UDim2.new(0, 8, 0, yPos + 16)
    back.BackgroundColor3 = Color3.fromRGB(20,20,20)
    back.BorderSizePixel = 0

    local fill = Instance.new("Frame", back)
    fill.Size = UDim2.new(math.clamp(initialVal / maxVal, 0, 1), 0, 1, 0)
    fill.BackgroundColor3 = blurple

    local draggingFill = false
    track(back.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingFill = true end end))
    track(back.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingFill = false end end))
    track(UserInputService.InputChanged:Connect(function(input)
        if draggingFill and input.UserInputType == Enum.UserInputType.MouseMovement then
            local relX = math.clamp(input.Position.X - back.AbsolutePosition.X, 0, back.AbsoluteSize.X)
            fill.Size = UDim2.new(0, relX, 1, 0)
            local val = (relX / back.AbsoluteSize.X) * maxVal
            callback(val)
        end
    end))
end

