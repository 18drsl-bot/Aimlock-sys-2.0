-- Automatically fit the menu when options are added, removed, or expanded.
-- The original Y positions are the collapsed layout; expanding the dropdown
-- shifts controls below it without covering them.
local basePositions = {}
for _, child in ipairs(frame:GetChildren()) do
    if child:IsA("GuiObject") then
        basePositions[child] = child.Position
    end
end

local fitting = false
local function fitMenu()
    if fitting or unloaded then return end
    fitting = true
    local shift = optionsFrame.Size.Y.Offset
    local dropdownBottom = optionsFrame.Position.Y.Offset
    local maxBottom = 0
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("GuiObject") then
            if not basePositions[child] then basePositions[child] = child.Position end
            local base = basePositions[child]
            local y = base.Y.Offset
            if child ~= optionsFrame and y >= dropdownBottom then
                y = y + shift
            end
            child.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, y)
            maxBottom = math.max(maxBottom, y + child.Size.Y.Offset)
        end
    end
    frame.Size = UDim2.fromOffset(180, maxBottom + 8)
    fitting = false
end

track(optionsFrame:GetPropertyChangedSignal("Size"):Connect(fitMenu))
track(frame.ChildAdded:Connect(function(child)
    if child:IsA("GuiObject") then
        basePositions[child] = child.Position
        task.defer(fitMenu)
    end
end))
track(frame.ChildRemoved:Connect(function(child)
    basePositions[child] = nil
    task.defer(fitMenu)
end))
fitMenu()

