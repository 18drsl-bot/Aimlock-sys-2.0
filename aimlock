-- AUTO‑FIT EVERYTHING INSIDE THE GUI
task.defer(function()
    local padding = 8
    local totalHeight = 0

    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("GuiObject") then
            local yPos = child.AbsolutePosition.Y - frame.AbsolutePosition.Y
            local h = child.AbsoluteSize.Y
            totalHeight = math.max(totalHeight, yPos + h)
        end
    end

    frame.Size = UDim2.new(0, 180, 0, totalHeight + padding)
end)

