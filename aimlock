    else
        if fallbackGui then fallbackGui.Enabled = v end
    end
end

local function dist(a,b)
    local dx,dy = a.X-b.X, a.Y-b.Y
    return math.sqrt(dx*dx + dy*dy)
end

-- Resolve the selected target across R6, R15 and custom rigs.
local function getBestPart(char)
    if not char then return nil end
    local priorities
    if TARGET_PART_NAME == "Head" then
        priorities = {"Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart"}
    elseif TARGET_PART_NAME == "Torso" then
        priorities = {"UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart", "Head"}
    else
        priorities = {"HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head"}
    end
    for _, name in ipairs(priorities) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then return part end
    end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end

local function findTarget(cursorPos)
    local best, bestDist
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local part = getBestPart(plr.Character)
            if part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                    local d = dist(screenVec, cursorPos)
                    if d <= radius and (not bestDist or d < bestDist) then
                        best, bestDist = part, d
                    end
                end
            end
        end
    end
    return best
end

-- Input
track(UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        mouseLocation = UserInputService:GetMouseLocation()
    end
end))

track(UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == lockKey then
        rmbDown = true
    end

    if listeningForLockKey and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            lockKey = input.KeyCode
            lockKeyBtn.Text = "Key: " .. lockKey.Name
            listeningForLockKey = false
            changeLockKeyBtn.Text = "Change Key"
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == lockKey then
        rmbDown = false
    end
end))

-- Render
track(RunService.RenderStepped:Connect(function()
    if aimEnabled then
        if hasDrawing then
            drawingCircle.Position = mouseLocation
            drawingCircle.Radius = radius
            drawingCircle.Thickness = thickness
            drawingCircle.Visible = true
        else
            fallbackCircle.Position = UDim2.new(0, mouseLocation.X, 0, mouseLocation.Y)
            fallbackCircle.Size = UDim2.new(0, radius*2, 0, radius*2)
        end
    else
        setCircleVisible(false)
    end

    if aimEnabled and rmbDown then
        local target = findTarget(mouseLocation)
        if target then
            local camPos = Camera.CFrame.Position
            Camera.CFrame = CFrame.new(camPos, target.Position)
        end
    end

    Camera.FieldOfView = fovValue
end))

