local function unload()
    if unloaded then return end
    unloaded = true
    aimEnabled = false
    rmbDown = false
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(connections)
    if drawingCircle then
        pcall(function() drawingCircle:Remove() end)
        drawingCircle = nil
    end
    for _, object in ipairs(createdObjects) do
        pcall(function() object:Destroy() end)
    end
    table.clear(createdObjects)
    if workspace.CurrentCamera then
        workspace.CurrentCamera.FieldOfView = previousFov
    end
    if globalEnvironment[INSTANCE_KEY] and globalEnvironment[INSTANCE_KEY].Unload == unload then
        globalEnvironment[INSTANCE_KEY] = nil
    end
end

globalEnvironment[INSTANCE_KEY] = {Unload = unload}
